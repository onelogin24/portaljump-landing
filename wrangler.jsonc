{
  "name": "portaljump-landing",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "WAITLIST_ENDPOINT": "https://script.google.com/macros/s/AKfycbyvVjPNWM-w7t2I-tAbthUmf9VyAE7CXdfnkYrbYt-pQ9wZ31sDXP3WHq8bp4rniCP8/exec"
  }
}
